limit_req_zone $binary_remote_addr zone=subscription_gateway:10m rate=5r/s;

server {
    listen __LISTEN_PORT__ ssl http2;
    listen [::]:__LISTEN_PORT__ ssl http2;
    server_name __DOMAIN__;

    ssl_certificate __CERT_FILE__;
    ssl_certificate_key __KEY_FILE__;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    client_max_body_size 32m;

    location / {
        limit_req zone=subscription_gateway burst=20 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }
}
